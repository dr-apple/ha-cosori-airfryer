{
  "config": {
    "step": {
      "user": {
        "title": "VeSync account",
        "description": "Log in with the account you use in the VeSync app. Your fryer is controlled through the VeSync cloud.",
        "data": {
          "username": "Email",
          "password": "Password",
          "country_code": "Country code"
        },
        "data_description": {
          "country_code": "Two-letter country of the VeSync account, e.g. DE."
        }
      },
      "reauth_confirm": {
        "title": "Log in again",
        "description": "Enter the VeSync password for {username}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password.",
      "cannot_connect": "Cannot reach the VeSync cloud.",
      "no_fryers": "No air fryer found in this VeSync account.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This account is already set up.",
      "reauth_successful": "Logged in again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Push notifications",
        "description": "Get a message when a basket is done. With different cooking times each basket can announce itself.",
        "data": {
          "notify_enabled": "Send notifications",
          "notify_target": "Notification service",
          "notify_apart": "One message per basket when they finish at different times",
          "notify_together": "One message when both finish together (or only one basket is used)",
          "notify_tolerance": "Finish times closer than this count as together",
          "notify_basket_1": "Notify for basket 1",
          "notify_basket_2": "Notify for basket 2"
        },
        "data_description": {
          "notify_target": "A notify action such as notify.mobile_app_my_phone or a notify group. Empty: a message in the Home Assistant sidebar."
        }
      }
    }
