  "services": {
    "start_cooking": {
      "name": "Start cooking",
      "description": "Starts a cook. Missing values use the program's defaults; values are clamped to the program's limits.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "The fryer to use."
        },
        "chamber": {
          "name": "Basket",
          "description": "Basket 1, basket 2, the whole basket or both in sync."
        },
        "mode": {
          "name": "Program",
          "description": "Cook program."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Cook temperature in °C."
        },
        "duration": {
          "name": "Cook time",
          "description": "Cook time in minutes."
        }
      }
    },
    "end_cooking": {
      "name": "End cooking",
      "description": "Ends the cook in a basket, or everything.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "The fryer to use."
        },
        "chamber": {
          "name": "Basket",
          "description": "Which basket to end; 'both' ends everything."
        }
      }
    },
    "schedule_start": {
      "name": "Plan a start",
      "description": "Freezes the current settings and starts the fryer at the given time (or so that it finishes then).",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Air fryer"
        },
        "time": {
          "name": "Time",
          "description": "Start or finish time."
        },
        "type": {
          "name": "Type",
          "description": "Whether the time is the start or the finish."
        }
      }
    },
    "cancel_schedule": {
      "name": "Cancel planned start",
      "description": "Cancels the planned start.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Air fryer"
        }
      }
    }
